---
import { LOCALES, LOCALE_META, SUPPORT_URL, localePath, type Locale } from '../i18n/locales';
import { useUi } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props { locale: Locale; page: string; compact?: boolean }
const { locale, page, compact = false } = Astro.props;
const ui = useUi(locale);

const links = [
  { page: '/guides/', label: ui.nav.guides },
  { page: '/milestones/', label: ui.nav.milestones },
  { page: '/tools/', label: ui.nav.tools },
  { page: '/faq/', label: ui.nav.faq }
];
const isActive = (target: string) => page.startsWith(target);
---
<header class="site-header">
  <div class={`container-page flex items-center gap-2 ${compact ? 'h-14' : 'h-16'}`}>
    <a href={localePath(locale, '/')} class="mr-auto flex min-w-0 items-center gap-2 rounded-xl text-[var(--nt-text)] no-underline" aria-label={`${ui.siteName} — ${ui.nav.home}`}>
      <Logo class="h-9 w-9 shrink-0" />
      <span class="truncate text-lg font-black tracking-tight">{ui.siteName}</span>
    </a>

    <nav aria-label={ui.menu} class="hidden items-center gap-1 lg:flex">
      {links.map(link => (
        <a class="nav-link" href={localePath(locale, link.page)} aria-current={isActive(link.page) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <a href={SUPPORT_URL} target="_blank" rel="noopener" class="btn-kofi hidden text-sm sm:inline-flex" data-support-link>
      <span aria-hidden="true">♥</span>{ui.nav.support}
    </a>

    <details class="dropdown relative">
      <summary class="icon-btn text-sm font-black" aria-label={ui.language}>
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      </summary>
      <div class="dropdown-panel">
        {LOCALES.map(alt => (
          <a class="dropdown-item" href={localePath(alt, page)} hreflang={LOCALE_META[alt].hreflang} lang={LOCALE_META[alt].htmlLang} data-set-locale={alt} aria-current={alt === locale ? 'true' : undefined}>
            <span>{LOCALE_META[alt].label}</span>
            {alt === locale && <span aria-hidden="true" class="text-pink-600">✓</span>}
          </a>
        ))}
      </div>
    </details>

    <button type="button" class="icon-btn" data-theme-toggle aria-label={ui.themeToggle}>
      <svg aria-hidden="true" class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      <svg aria-hidden="true" class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>

    {!compact && (
      <a href={localePath(locale, '/app/')} class="btn-primary hidden !min-h-[2.6rem] !px-4 text-sm md:inline-flex">{ui.openApp}</a>
    )}

    <details class="dropdown relative lg:hidden">
      <summary class="icon-btn" aria-label={ui.menu}>
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <nav class="dropdown-panel w-64" aria-label={ui.menu}>
        <a class="dropdown-item" href={localePath(locale, '/app/')}>{ui.nav.app} <span aria-hidden="true">→</span></a>
        {links.map(link => <a class="dropdown-item" href={localePath(locale, link.page)}>{link.label}</a>)}
        <a class="dropdown-item" href={localePath(locale, '/about/')}>{ui.nav.about}</a>
        <a class="dropdown-item text-[#e5484d]" href={SUPPORT_URL} target="_blank" rel="noopener" data-support-link>♥ {ui.nav.support}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Theme toggle: remembers the choice for the whole site, including the tracker.
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(button => {
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('nt-theme', dark ? 'dark' : 'light'); } catch {}
      window.dispatchEvent(new CustomEvent('nt-theme', { detail: dark }));
    });
  });

  // Remember an explicit language choice so we stop suggesting another one.
  document.querySelectorAll<HTMLAnchorElement>('[data-set-locale]').forEach(link => {
    link.addEventListener('click', () => {
      try { localStorage.setItem('nt-locale', link.dataset.setLocale || ''); } catch {}
    });
  });

  // Close an open dropdown when clicking elsewhere.
  document.addEventListener('click', event => {
    document.querySelectorAll<HTMLDetailsElement>('details.dropdown[open]').forEach(details => {
      if (!details.contains(event.target as Node)) details.open = false;
    });
  });
</script>
