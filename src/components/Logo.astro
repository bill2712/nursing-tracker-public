---
interface Props { class?: string }
const { class: className = 'h-9 w-9' } = Astro.props;
const gradientId = `nt-logo-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={className} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fce7f3" />
      <stop offset="1" stop-color="#e0e7ff" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="18" fill={`url(#${gradientId})`} />
  <path d="M23 15h18v7c0 2.5 1.2 4.8 3.2 6.3V47a7 7 0 0 1-7 7H26.8a7 7 0 0 1-7-7V28.3A7.8 7.8 0 0 0 23 22v-7Z" fill="#fff" stroke="#db2777" stroke-width="4" stroke-linejoin="round" />
  <path d="M25 35h14M25 42h14" stroke="#f472b6" stroke-width="4" stroke-linecap="round" />
  <path d="M23 21h18" stroke="#db2777" stroke-width="4" stroke-linecap="round" />
</svg>
