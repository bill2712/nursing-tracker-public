---
import Base from '../../../layouts/Base.astro';
import AppRoot from '../../../app/AppRoot';
import { LOCALES, LOCALE_META, SUPPORT_URL, BRAND, localeStaticPaths, localePath, absoluteUrl, type Locale } from '../../../i18n/locales';
import { useUi } from '../../../i18n/ui';
import { DEV_MONTHS } from '../../../data/development';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const ui = useUi(locale);

const links = {
  home: localePath(locale, '/'),
  guides: localePath(locale, '/guides/'),
  milestones: localePath(locale, '/milestones/'),
  privacy: localePath(locale, '/privacy/'),
  support: SUPPORT_URL,
  languages: LOCALES.map(alt => ({ locale: alt, label: LOCALE_META[alt].label, href: `${localePath(alt, '/app/')}`, current: alt === locale }))
};
const monthLabels = Object.fromEntries(DEV_MONTHS.map(n => [n, ui.milestones.monthShort(n)]));

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${BRAND} — ${ui.tagline}`,
  url: absoluteUrl(localePath(locale, '/app/')),
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any (web browser)',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  inLanguage: LOCALE_META[locale].htmlLang,
  description: ui.appPage.metaDescription
}];
---
<Base locale={locale} title={ui.appPage.metaTitle} description={ui.appPage.metaDescription} page="/app/" variant="app" jsonLd={jsonLd}>
  <h1 class="sr-only">{ui.appPage.metaTitle}</h1>
  <AppRoot client:only="react" locale={locale} links={links} milestonesBase={localePath(locale, '/milestones/')} monthLabels={monthLabels} loadingLabel={ui.appPage.loading} />
  <noscript>
    <div class="container-page py-16 text-center">
      <p class="text-lg font-bold">{ui.appPage.noscript}</p>
      <p class="muted mt-2">{ui.appPage.metaDescription}</p>
    </div>
  </noscript>
</Base>
